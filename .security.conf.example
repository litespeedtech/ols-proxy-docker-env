# Global security configuration. This file applies to every mapped domain.

# Per-client throttling, used only when THROTTLING=true.
THROTTLING_STATIC_REQ_PER_SEC=100
THROTTLING_DYNAMIC_REQ_PER_SEC=20
THROTTLING_OUT_BANDWIDTH=0
THROTTLING_IN_BANDWIDTH=0
THROTTLING_SOFT_LIMIT=15
THROTTLING_HARD_LIMIT=20
THROTTLING_BLOCK_BAD_REQUEST=true
THROTTLING_GRACE_PERIOD=15
THROTTLING_BAN_PERIOD=60

# CAPTCHA policy, used only when RECAPTCHA=true.
# Accepted RECAPTCHA_TYPE values: checkbox, invisible, hcaptcha.
RECAPTCHA_TYPE=checkbox
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MAX_TRIES=3
RECAPTCHA_ALLOWED_ROBOT_HITS=3
RECAPTCHA_CONNECTION_LIMIT=100
RECAPTCHA_SSL_CONNECTION_LIMIT=100
