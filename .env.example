OLS_IMAGE=litespeedtech/openlitespeed:latest

BACKEND_IP=192.168.0.1
# May be an IP address, hostname, or Docker service/container name.

BACKEND_PORT=1234
DOMAIN=www.example.com
# Empty value uses the standard ACME installation without the advanced email option.
ACME_EMAIL=

PROXY_SOCKET=false
# Optional: defaults to BACKEND_IP and BACKEND_PORT when PROXY_SOCKET=true.
# PROXY_SOCKET_IP=backend-service
# PROXY_SOCKET_PORT=8080
