OLS_IMAGE=litespeedtech/openlitespeed:latest

### May be an IP address, hostname, or Docker service/container name.
BACKEND_IP=192.168.0.1
BACKEND_PORT=1234
DOMAIN=www.example.com

### R/rewrite uses a rewrite rule; C/context uses an OLS proxy context.
PROXY_METHOD=context
### Context mode only; exactly one validated OLS header operation is allowed.
### Syntax: <Header|RequestHeader> <set|append|merge|add|unset> <header-name> ["value"]
# HEADER_SET=RequestHeader set Origin "https://${DOMAIN}"

### Optional: defaults to BACKEND_IP and BACKEND_PORT when PROXY_SOCKET=true.
# PROXY_SOCKET_IP=backend-service
# PROXY_SOCKET_PORT=8080
PROXY_SOCKET=true

### Empty value uses the standard ACME installation without the advanced email option.
ACME_EMAIL=

### Global security controls. These apply to every mapped domain and cannot be set in domains.conf.
THROTTLING=false
RECAPTCHA=false
MODSECURITY=false

### Per-client throttling values used only when THROTTLING=true.
THROTTLING_STATIC_REQ_PER_SEC=100
THROTTLING_DYNAMIC_REQ_PER_SEC=20
THROTTLING_OUT_BANDWIDTH=0
THROTTLING_IN_BANDWIDTH=0
THROTTLING_SOFT_LIMIT=20
THROTTLING_HARD_LIMIT=40
THROTTLING_BLOCK_BAD_REQUEST=true
THROTTLING_GRACE_PERIOD=15
THROTTLING_BAN_PERIOD=60

### CAPTCHA values used only when RECAPTCHA=true. Use provider keys that cover every proxied domain.
### RECAPTCHA_TYPE: checkbox, invisible, or hcaptcha.
RECAPTCHA_TYPE=invisible
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MAX_TRIES=3
RECAPTCHA_ALLOWED_ROBOT_HITS=3
RECAPTCHA_CONNECTION_LIMIT=100
RECAPTCHA_SSL_CONNECTION_LIMIT=100

### OWASP CRS is baked into the image. Change the version only with: docker compose up -d --build
### Use a supported ModSecurity 3.x CRS release; OpenLiteSpeed does not support ModSecurity 2.x rules.
OWASP_CRS_VERSION=4.21.0
